{
  "role": "lab stand-in for the Runtime generator's input, not a manifest field",
  "provider": "model-provider",
  "rights": [
    {
      "id": "storage",
      "rules": [
        "(allow file-read* (literal (param \"STORAGE_PARENT\")))",
        "(allow file-read* file-write* (subpath (param \"STORAGE_ROOT\")))"
      ]
    },
    {
      "id": "bound-executable",
      "rules": [
        "(allow process-exec (literal (param \"PROVIDER_EXECUTABLE\")))"
      ]
    },
    {
      "id": "model-gpu",
      "rules": [
        "(allow file-read* (regex \"^/System/Library/Extensions/AGXMetal[A-Za-z0-9_]+\\\\.bundle(/.*)?$\"))",
        "(allow iokit-open-user-client (iokit-user-client-class \"AGXDeviceUserClient\") (iokit-user-client-class \"IOSurfaceRootUserClient\"))",
        "(allow mach-lookup (global-name \"com.apple.MTLCompilerService\"))"
      ]
    },
    {
      "id": "local-model-files",
      "rules": [
        "(allow file-read* (literal (param \"MODEL\")))",
        "(allow process-exec (literal (param \"ENGINE\")))",
        "(allow file-read* (literal (param \"ENGINE_LIBRARY\")))",
        "(allow file-read* file-write-data (literal (param \"ENGINE_SOCKET\")))"
      ]
    }
  ],
  "platform_baseline": {
    "status": "Runtime platform baseline for the model-provider executable on macOS, not approved rights",
    "rules": [
      {
        "id": "startup-root-directory",
        "justification": "macOS model-provider executable bound as PROVIDER_EXECUTABLE: Process startup reads the root directory before `main` runs",
        "rules": [
          "(allow file-read-data (literal \"/\"))"
        ]
      },
      {
        "id": "startup-sysctl",
        "justification": "macOS model-provider executable bound as PROVIDER_EXECUTABLE: At startup the Rust runtime reads the page size to place its stack guard page.",
        "rules": [
          "(allow sysctl-read)"
        ]
      },
      {
        "id": "model-launch-inputs",
        "justification": "macOS model-provider executable bound as PROVIDER_EXECUTABLE: Runtime-owned measured X1-X4 engine and private socket inputs.",
