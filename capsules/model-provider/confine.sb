;; Seatbelt profile for model-provider; this file is the test oracle the
;; Runtime-generated profile must match. The generated profile binds three
;; resolved paths as parameters, the same names every file profile uses, and
;; the tests pass them with /usr/bin/sandbox-exec -f confine.sb -D. That
;; M1a Runtime inputs are rendered but the production caller is a later slice.
;; A lab generator in capsules/wallet-provider/tests/confine.rs is test code, and its equality test does not read this file.
;; The Runtime generator pins these forms without switching the production caller.
;;   PROVIDER_EXECUTABLE  - the canonical provider binary
;;   STORAGE_ROOT         - the model journal root: Init.base_path/providers/model-provider,
;;                          or the configured absolute journal_dir
;;   STORAGE_PARENT       - the existing parent of STORAGE_ROOT
;; Every operation no rule grants is refused, including every network operation.
(version 1)
(deny default)
;; The provider speaks stdin/stdout only; no socket or listener is granted.
(deny network*)

;; Startup: execute only the bound provider binary.
(allow process-exec (literal (param "PROVIDER_EXECUTABLE")))
;; Startup: every process reads the root directory before main runs.
(allow file-read-data (literal "/"))
;; Startup: the Rust runtime reads the page size to place its stack guard page.
(allow sysctl-read)
;; Journal: inspect the existing parent while creating the journal root.
(allow file-read* (literal (param "STORAGE_PARENT")))
;; Journal: one grant covers the run records under the journal root.
(allow file-read* file-write* (subpath (param "STORAGE_ROOT")))

;; macOS probe X5, X6, and the X4 /System read for the Metal bundle.
(allow file-read* (subpath "/System"))
(allow iokit-open-user-client (iokit-user-client-class "AGXDeviceUserClient") (iokit-user-client-class "IOSurfaceRootUserClient"))
(allow mach-lookup (global-name "com.apple.MTLCompilerService"))
;; macOS probe X2, then proposal row 4: process and artifact inputs.
(allow process-fork)
(allow file-read* (literal (param "MODEL")))
(allow file-read* (literal "/dev/urandom"))
(allow file-read* file-write-data (literal "/dev/null"))
(allow process-exec (literal (param "ENGINE")))
(allow file-read* (subpath (param "ENGINE_BUNDLE")))
;; macOS probe X4: /usr/lib is a launch input. It is not GPU access.
(allow file-read* (subpath "/usr/lib"))
;; macOS probe X1: exact metadata ancestors from the measured lab layout.
(allow file-read-metadata (literal (param "MODEL_ANCESTOR_0")))
(allow file-read-metadata (literal (param "MODEL_ANCESTOR_1")))
(allow file-read-metadata (literal (param "MODEL_ANCESTOR_2")))
(allow file-read-metadata (literal (param "MODEL_ANCESTOR_3")))
(allow file-read-metadata (literal (param "MODEL_ANCESTOR_4")))
(allow file-read-metadata (literal (param "MODEL_ANCESTOR_5")))
(allow file-read-metadata (literal (param "MODEL_ANCESTOR_6")))
(allow file-read-metadata (literal (param "MODEL_ANCESTOR_7")))
(allow file-read-metadata (literal (param "MODEL_ANCESTOR_8")))
(allow file-read-metadata (literal (param "MODEL_ANCESTOR_9")))
(allow file-read-metadata (literal (param "MODEL_ANCESTOR_10")))
(allow file-read-metadata (literal (param "MODEL_ANCESTOR_11")))
(allow file-read-metadata (literal (param "MODEL_ANCESTOR_12")))
(allow file-read-metadata (literal (param "MODEL_ANCESTOR_13")))
(allow file-read-metadata (literal (param "MODEL_ANCESTOR_14")))
(allow file-read-metadata (literal (param "MODEL_ANCESTOR_15")))
(allow file-read-metadata (literal (param "MODEL_ANCESTOR_16")))
(allow file-read-metadata (literal (param "MODEL_ANCESTOR_17")))
(allow file-read-metadata (literal (param "MODEL_ANCESTOR_18")))
;; macOS probe X3: 64 broker sockets and engine sockets.
(allow network-outbound (literal (param "BROKER_SOCKET_0")))
(allow file-read-metadata (literal (param "ENGINE_SOCKET_0")))
(allow file-write* (literal (param "ENGINE_SOCKET_0")))
(allow network-bind (literal (param "ENGINE_SOCKET_0")))
