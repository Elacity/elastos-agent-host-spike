0x0006  0  0 0x7fff0000  # allow
0x0015  0  1 0x00000049  # SYS_ppoll
0x0006  0  0 0x7fff0000  # allow
0x0015  0  1 0x00000043  # SYS_pread64
0x0006  0  0 0x7fff0000  # allow
0x0015  0  1 0x00000044  # SYS_pwrite64
0x0006  0  0 0x7fff0000  # allow
0x0015  0  1 0x0000003f  # SYS_read
0x0006  0  0 0x7fff0000  # allow
0x0015  0  1 0x0000004e  # SYS_readlinkat
