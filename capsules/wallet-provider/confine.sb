;; Seatbelt profile for wallet-provider; the signed bundle owns this single source.
;; The Runtime starts this provider with /usr/bin/sandbox-exec -f confine.sb and
;; passes resolved paths:
;;   PROVIDER_EXECUTABLE  - the signed provider binary it starts
;;   STORAGE_ROOT         - Init.base_path/ElastOS/SystemServices/Wallet
;;   STORAGE_PARENT       - the existing parent of STORAGE_ROOT
;; did-provider binds the same three parameter names, so the Runtime has one
;; parameterized launch for both file-profile providers.
;; Everything else is denied, including every network operation.
(version 1)

;; Deny by default: a file, device, socket or process operation that no rule
;; below grants is refused, so an unexpected request fails closed.
(deny default)
(deny network*)

;; Startup: exec and the program read are pinned to the one binary the Runtime
;; named, so the provider cannot start any other program.
(allow process-exec (literal (param "PROVIDER_EXECUTABLE")))
(allow file-read* (literal (param "PROVIDER_EXECUTABLE")))

;; Startup: the kernel resolves every absolute path through the root directory,
;; so the loader can reach the binary it was given.
(allow file-read* (literal "/"))

;; Startup: dyld reads the system shared cache and system libraries; the signed
;; bundle ships no other library.
(allow file-read*
  (subpath "/usr/lib")
  (subpath "/System/Library")
  (subpath "/Library/Apple"))

;; Startup: the loader and the allocator read kernel facts and the entropy
;; device before the stdin/stdout protocol starts.
(allow sysctl-read)
(allow file-read* (literal "/dev/urandom"))

;; Startup: inspect and synchronize the existing parent when creating Wallet.
(allow file-read* (literal (param "STORAGE_PARENT")))

;; Wallet state: one grant covers account, key, challenge and approval files.
(allow file-read* file-write* (subpath (param "STORAGE_ROOT")))
