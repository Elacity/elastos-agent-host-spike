{
  "about": "cc-capsule-identity 001 lab falsifiers. Each one plants a bug in the lab CID harness (src/lib.rs), a fixture manifest, or the wc-001 test driver, and requires every named test to FAIL for its own reason, never from a build error. command is \"lab\" and file paths are relative to examples/agent-host/, so a lane file is ../../lab/capsule-identity/... . The canonical runner falsify.py has no \"lab\" command yet (ask R1), so each is proved by hand until R1 lands: break, run the named tests with `cargo test --locked` in this lane, see each fail, revert.",
  "falsifiers": [
    {
      "id": "F-CI1a",
      "title": "name files in listing order: the encoder drops its sort",
      "command": "lab",
      "expect": "caught",
      "edits": [
        {
          "file": "../../lab/capsule-identity/src/lib.rs",
          "old": "    sorted.sort_by(|a, b| a.path.as_bytes().cmp(b.path.as_bytes()));\n",
          "new": ""
        }
      ],
      "tests": [
        "lab_cid_does_not_depend_on_listing_order"
      ]
    },
    {
      "id": "F-CI1b",
      "title": "drop the two length prefixes, so path and content boundaries can collide",
      "command": "lab",
      "expect": "caught",
      "edits": [
        {
          "file": "../../lab/capsule-identity/src/lib.rs",
          "old": "        hasher.update((entry.path.len() as u64).to_be_bytes());\n        hasher.update(entry.path.as_bytes());\n        hasher.update((entry.content.len() as u64).to_be_bytes());\n        hasher.update(&entry.content);\n",
          "new": "        hasher.update(entry.path.as_bytes());\n        hasher.update(&entry.content);\n"
        }
      ],
      "tests": [
        "path_and_content_boundaries_cannot_collide"
      ]
    },
    {
      "id": "F-CI1c",
      "title": "fold the wall-clock time into the stream",
      "command": "lab",
      "expect": "caught",
      "edits": [
        {
          "file": "../../lab/capsule-identity/src/lib.rs",
          "old": "    hasher.update(FRAMING_TAG);\n",
          "new": "    hasher.update(FRAMING_TAG);\n    hasher.update(\n        std::time::SystemTime::now()\n            .duration_since(std::time::UNIX_EPOCH)\n            .unwrap_or_default()\n            .as_nanos()\n            .to_be_bytes(),\n    );\n"
        }
      ],
      "tests": [
        "lab_cid_matches_the_pinned_value_for_each_fixture"
      ]
    },
    {
      "id": "F-CI1d",
      "title": "print the bare hex, without the lab-cid:sha256: label",
      "command": "lab",
      "expect": "caught",
      "edits": [
        {
          "file": "../../lab/capsule-identity/src/lib.rs",
          "old": "        write!(f, \"{LAB_CID_PREFIX}{}\", hex::encode(self.0))\n",
          "new": "        write!(f, \"{}\", hex::encode(self.0))\n"
        }
      ],
      "tests": [
        "lab_cid_prints_with_the_lab_label"
      ]
    },
