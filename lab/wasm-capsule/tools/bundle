#!/usr/bin/env bash
# The wc-003 lab bundle: one capsule closure, named by its hash.
#
#   tools/bundle [OUT_DIR]            build with tools/build, write OUT_DIR/bundle/, print its lab name
#   tools/bundle --name BUNDLE_DIR    print the lab name of an existing bundle
#
# OUT_DIR defaults to the lane root. OUT_DIR/bundle/ holds exactly the closure:
# capsule.json (the lab manifest) and capsule.wasm (the module tools/build
# made). Anything else in a bundle is refused, with its path and the reason.
#
# The name is a LAB name, `lab-sha256:<hex>`, over the canonical closure (sorted
# paths, exact bytes, no mtimes or modes). It is not a CID and never a package
# identity: README.md defines the bytes, ADOPTION.md says why it is not the
# Runtime's rule.
#
# The work is done by the lane's `bundle` binary (tools/bundle.rs), which names
# every bundle through the one closure rule in tools/lab_name.rs.
set -euo pipefail

LANE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
exec cargo run --quiet --locked --manifest-path "$LANE_DIR/Cargo.toml" --bin bundle -- "$@"
