#!/usr/bin/env bash
# A stand-in tools/build that writes the module, then plants a link at
# OUT_DIR/bundle to the folder "sentinel" beside OUT_DIR ($1), as another
# process could during the build.
set -euo pipefail
printf '\000asm\001\000\000\000' > "$1/capsule.wasm"
ln -s "$(cd "$1/.." && pwd)/sentinel" "$1/bundle"
