{
  "about": "Audit crate falsifiers, proved by hand in the lab workspace while canonical runner gap R1 is pending. Paths are relative to examples/agent-host/. Every caught entry must build and all its named tests must run and fail. F-CWA0c expects Cargo to refuse the nested workspace under --locked. Restore each changed file byte-identical before the next entry.",
  "falsifiers": [
    {
      "id": "F-CWA0a",
      "title": "wasmparser loses its exact version pin",
      "command": "lab",
      "expect": "caught",
      "edits": [
        {
          "file": "../../lab/wasm-capsule/audit/Cargo.toml",
          "old": "wasmparser = \"=0.258.0\"",
          "new": "wasmparser = \"0.258.0\""
        }
      ],
      "tests": [
        "manifest_pins_only_wasmparser_and_wat_exactly"
      ]
    },
    {
      "id": "F-CWA0b",
      "title": "wat becomes a caller dependency",
      "command": "lab",
      "expect": "caught",
      "edits": [
        {
          "file": "../../lab/wasm-capsule/audit/Cargo.toml",
          "old": "\n[dev-dependencies]\nwat = \"=1.258.0\"",
          "new": "\nwat = \"=1.258.0\""
        }
      ],
      "tests": [
        "manifest_pins_only_wasmparser_and_wat_exactly"
      ]
    },
