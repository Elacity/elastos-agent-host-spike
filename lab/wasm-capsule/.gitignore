# Build output is never committed (no large files, P7): the artifact and its
# receipt are rebuilt from source by tools/build.
/target/
/capsule.wasm
/receipt.txt
# A test-key seed is never committed (wc-004). Test keys live in memory only;
# this is the backstop. `*.key` is the root .gitignore's rule, not repeated
# here (one rule, P10).
*.seed
