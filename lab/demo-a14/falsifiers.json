{
  "about": "demo-a14 falsifiers. Each one plants one bug in lab/demo-a14/demo.py or journeys.json and requires every named test to FAIL at an assertion, never from an import or syntax error; then the exact bytes are restored and the same tests pass. File paths are relative to the repository root. The shared runner examples/agent-host/falsify.py has no demo-a14 command, so these run by hand: apply the edit, run python3 -I -m unittest discover -s lab/demo-a14/tests -k <test>, require FAILED, restore, require OK.",
  "falsifiers": [
    {
      "id": "F-A14a",
      "title": "the gate skips the installed native binaries",
      "command": "demo-a14",
      "expect": "caught",
      "edits": [
        {
          "file": "lab/demo-a14/demo.py",
          "old": "        problems += compare(f\"installed {name}\", layout.install / \"bin\" / name, expected, source)\n",
          "new": ""
        }
      ],
      "tests": [
        "test_changed_installed_runtime_is_refused",
        "test_changed_installed_provider_is_refused",
        "test_refused_run_starts_no_journey"
      ]
    },
    {
      "id": "F-A14b",
      "title": "the gate skips the Runtime the journeys launch",
      "command": "demo-a14",
      "expect": "caught",
      "edits": [
        {
          "file": "lab/demo-a14/demo.py",
          "old": "        problems += compare(\n            f\"the {name} the journeys launch\", layout.runtime_build / name, expected, source\n        )\n",
          "new": ""
        }
      ],
      "tests": ["test_runtime_the_journeys_launch_must_match"]
    },
    {
      "id": "F-A14c",
      "title": "the gate trusts a VERSIONS.json changed after install",
      "command": "demo-a14",
      "expect": "caught",
      "edits": [
        {
          "file": "lab/demo-a14/demo.py",
          "old": "    if actual != record.get(\"versions_sha256\"):\n",
          "new": "    if False:\n"
        }
      ],
      "tests": ["test_swapped_receipt_is_refused"]
    },
    {
      "id": "F-A14d",
      "title": "the gate accepts a checkout at another commit",
      "command": "demo-a14",
      "expect": "caught",
      "edits": [
        {
          "file": "lab/demo-a14/demo.py",
          "old": "        if checkout.commit != commit:\n",
          "new": "        if False:\n"
        }
      ],
      "tests": ["test_receipt_from_another_commit_is_refused"]
    },
    {
      "id": "F-A14e",
      "title": "the gate accepts a checkout with local changes",
      "command": "demo-a14",
      "expect": "caught",
      "edits": [
        {
          "file": "lab/demo-a14/demo.py",
          "old": "        if not checkout.clean:\n            problems.append(\n",
          "new": "        if False:\n            problems.append(\n"
        }
      ],
      "tests": ["test_dirty_checkout_is_refused"]
    },
    {
      "id": "F-A14f",
      "title": "a receipt from a failed conformance run is accepted",
      "command": "demo-a14",
      "expect": "caught",
      "edits": [
        {
          "file": "lab/demo-a14/demo.py",
          "old": "    if receipt.get(\"command_success\") is not True:\n",
          "new": "    if False:\n"
        }
      ],
      "tests": ["test_incomplete_or_failed_receipt_is_refused"]
    },
    {
      "id": "F-A14g",
      "title": "the gate skips the agent-host component the journeys load",
      "command": "demo-a14",
      "expect": "caught",
      "edits": [
        {
          "file": "lab/demo-a14/demo.py",
          "old": "        problems += compare(\n            \"the agent-host component the journeys load\", layout.agent_host_wasm, pinned, source\n        )\n",
          "new": ""
        }
      ],
      "tests": ["test_changed_agent_host_component_is_refused"]
    },
    {
      "id": "F-A14h",
      "title": "the run goes on after the gate refuses",
      "command": "demo-a14",
      "expect": "caught",
      "edits": [
        {
          "file": "lab/demo-a14/demo.py",
          "old": "    problems = version_gate(layout, read(layout.repo))\n    if problems:\n        installed = ",
          "new": "    problems = version_gate(layout, read(layout.repo))\n    if False:\n        installed = "
        }
      ],
      "tests": ["test_refused_run_starts_no_journey"]
    },
    {
      "id": "F-A14i",
      "title": "a journey's Runtime identity is not compared",
      "command": "demo-a14",
      "expect": "caught",
      "edits": [
        {
          "file": "lab/demo-a14/demo.py",
