{
  "about": "demo-a14 falsifiers. Each one plants one bug in lab/demo-a14/demo.py or journeys.json and requires every named test to FAIL at an assertion, never from an import or syntax error; then the exact bytes are restored and the same tests pass. File paths are relative to the repository root. The shared runner examples/agent-host/falsify.py has no demo-a14 command, so these run by hand: apply the edit, run python3 -B -I -m unittest discover -s lab/demo-a14/tests -k <test> (-B, so no cached bytecode outlives a restore), require FAILED, restore, require OK.",
  "falsifiers": [
    {
      "id": "F-A14a",
      "title": "the gate skips the installed native binaries",
      "command": "demo-a14",
      "expect": "caught",
      "edits": [
        {
          "file": "lab/demo-a14/demo.py",
          "old": "        problems += compare(f\"installed {name}\", layout.install / \"bin\" / name, expected, source)\n",
          "new": ""
        }
      ],
      "tests": [
        "test_changed_installed_runtime_is_refused",
        "test_changed_installed_provider_is_refused",
        "test_refused_run_starts_no_journey"
      ]
    },
    {
