+fn coarse_now() -> (i64, i64) {
+    let mut now = libc::timespec {
+        tv_sec: 0,
+        tv_nsec: 0,
+    };
+    // CLOCK_REALTIME_COARSE is the stamp Linux 6.12 writes into ctime/mtime
+    // before multigrain timestamps. A write in this tick does not move them.
+    assert_eq!(
+        unsafe { libc::clock_gettime(libc::CLOCK_REALTIME_COARSE, &mut now) },
+        0
+    );
+    (now.tv_sec, now.tv_nsec)
+}
+
+/// Git racy-git: a stamp is not a generation if its ctime is not older than
+/// the time we recorded it. A later same-tick rewrite keeps that ctime.
+fn stamp_is_racy(stamp: &StatStamp, recorded_at: (i64, i64)) -> bool {
+    (stamp.ctime, stamp.ctime_nsec) >= recorded_at
+}
+
+fn wait_until_stamps_older_than_now(publication: &Publication) -> Result<(i64, i64)> {
+    loop {
+        let now = coarse_now();
+        let mut newest = (i64::MIN, 0);
+        for metadata in &publication.metadata_files {
+            let c = stamp(&metadata.file)?;
+            newest = newest.max((c.ctime, c.ctime_nsec));
+        }
+        for artifact in publication.artifacts.values() {
+            let c = stamp(&artifact.file)?;
+            newest = newest.max((c.ctime, c.ctime_nsec));
+        }
+        if newest < now {
+            return Ok(now);
+        }
+        std::hint::spin_loop();
+    }
+}
+
+fn ensure_same_generation(
+    file: &File,
+    admitted: &StatStamp,
+    expected_sha: &str,
+    recorded_at: (i64, i64),
+) -> Result<()> {
+    let now = stamp(file)?;
+    ensure!(now == *admitted, "publication file changed");
+    if stamp_is_racy(&now, recorded_at) {
+        ensure!(
+            stream_file(file, admitted.size, |_| Ok(()))? == expected_sha,
+            "publication file changed"
+        );
+    }
+    Ok(())
+}
+
