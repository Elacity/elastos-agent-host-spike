     "tests": ["refusals::refuses_when_user_namespaces_are_off", "refusals::refuses_when_the_capability_drop_fails", "refusals::refuses_when_seccomp_cannot_be_installed", "refusals::refuses_when_the_landlock_abi_is_too_old", "real_kernel::real_refusal_when_landlock_is_missing", "real_kernel::real_refusal_when_the_landlock_abi_is_too_old"]},
    {"id": "F-FC13", "claim": "Apply the id maps before the namespace exists: the layer order changes.",
