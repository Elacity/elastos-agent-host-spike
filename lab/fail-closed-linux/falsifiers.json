               {"file": "src/guard.rs", "find": "kernel.landlock_restrict(&policy.fs).map_err(|e| (Fault::LandlockApply, e))", "replace": "{ kernel.landlock_restrict(&policy.fs).map_err(|e| (Fault::LandlockApply, e))?; caps }"}],
