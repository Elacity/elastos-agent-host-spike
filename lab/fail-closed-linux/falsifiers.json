     "tests": ["refusals::refuses_when_the_landlock_ruleset_cannot_be_applied", "real_kernel::real_refusal_when_the_landlock_ruleset_cannot_be_applied"]},
    {"id": "F-FC09", "claim": "Lower the Landlock floor from ABI 5 to ABI 1.",
     "edits": [{"file": "src/guard.rs", "find": "pub const REQUIRED_LANDLOCK_ABI: u32 = 5;", "replace": "pub const REQUIRED_LANDLOCK_ABI: u32 = 1;"}],
     "tests": ["refusals::refuses_when_the_landlock_abi_is_too_old", "refusals::the_landlock_floor_cannot_be_lowered_and_can_be_raised"]},
