{
  "about": "Each falsifier plants one bug in a scratch copy of this crate and requires every named test to fail at an assertion. Test names are <test file>::<test name>. falsify.py in this folder runs them; the shared falsify.py under examples/agent-host has no entry for this crate.",
  "falsifiers": [
    {"id": "F-FC00", "expect": "survives", "claim": "Runner control: a change that alters nothing must SURVIVE, so the runner does not call every run a catch.",
     "edits": [{"file": "src/guard.rs", "find": "Ok(child) => Ok(child),", "replace": "Ok(child) => Ok(child),"}],
     "tests": ["refusals::refuses_when_no_new_privs_cannot_be_set"]},
    {"id": "F-FC01", "claim": "Ignore a user-namespace failure and carry on: the provider would run without the namespace.",
     "edits": [{"file": "src/guard.rs", "find": "kernel.unshare_user().map_err(|e| (Fault::UserNamespaceOff, e))?;", "replace": "let _ = kernel.unshare_user();"}],
     "tests": ["refusals::refuses_when_user_namespaces_are_off", "real_kernel::real_refusal_when_user_namespaces_are_off"]},
    {"id": "F-FC02", "claim": "Ignore a failed id-map write and carry on.",
     "edits": [{"file": "src/guard.rs", "find": "kernel.map_ids().map_err(|e| (Fault::IdMapRefused, e))?;", "replace": "let _ = kernel.map_ids();"}],
     "tests": ["refusals::refuses_when_the_id_maps_cannot_be_written"]},
    {"id": "F-FC03", "claim": "Ignore a failed capability drop and carry on: the provider would keep its capabilities.",
     "edits": [{"file": "src/guard.rs", "find": "kernel.drop_capabilities().map_err(|e| (Fault::CapabilityDrop, e))?;", "replace": "let _ = kernel.drop_capabilities();"}],
     "tests": ["refusals::refuses_when_the_capability_drop_fails", "real_kernel::real_refusal_when_the_capability_drop_fails"]},
    {"id": "F-FC04", "claim": "Ignore a failed no_new_privs and carry on.",
     "edits": [{"file": "src/guard.rs", "find": "kernel.set_no_new_privs().map_err(|e| (Fault::NoNewPrivs, e))?;", "replace": "let _ = kernel.set_no_new_privs();"}],
     "tests": ["refusals::refuses_when_no_new_privs_cannot_be_set", "real_kernel::real_refusal_when_no_new_privs_cannot_be_set"]},
    {"id": "F-FC05", "claim": "Ignore a failed seccomp install and carry on: the provider would run with no filter.",
     "edits": [{"file": "src/guard.rs", "find": "kernel.install_seccomp(&policy.seccomp).map_err(|e| (Fault::SeccompInstall, e))?;", "replace": "let _ = kernel.install_seccomp(&policy.seccomp);"}],
     "tests": ["refusals::refuses_when_seccomp_cannot_be_installed", "real_kernel::real_refusal_when_seccomp_cannot_be_installed"]},
    {"id": "F-FC06", "claim": "Treat a kernel with no Landlock as a kernel with the newest Landlock.",
     "edits": [{"file": "src/guard.rs", "find": "Err(e) if e == libc::ENOSYS || e == libc::EOPNOTSUPP => return Err((Fault::LandlockMissing, e)),", "replace": "Err(e) if e == libc::ENOSYS || e == libc::EOPNOTSUPP => u32::MAX,"}],
     "tests": ["refusals::refuses_when_landlock_is_missing", "real_kernel::real_refusal_when_landlock_is_missing"]},
    {"id": "F-FC07", "claim": "Accept any Landlock ABI: an old kernel would leave rights unrestricted.",
