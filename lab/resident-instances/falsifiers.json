      "expect": "caught",
      "edits": [
        {
          "file": "../../lab/resident-instances/src/journey.rs",
          "old": "        let new = j.new_processes()?;\n        if !new.is_empty() {\n            return Err(format!(\n                \"the two instances added {} processes below the Runtime; resident instances run inside it\",\n                new.len()\n            ));\n        }\n",
          "new": ""
        }
      ],
      "tests": [
        "a3_refuses_a_process_per_instance"
      ]
    },
