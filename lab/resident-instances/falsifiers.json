{
  "about": "Lane falsifiers for lab/resident-instances, in the shared data format. Each replaces exact text (found once) and requires every named test to fail; restoring the bytes must make them pass. The shared runner has no resident-instances command, so these run by hand; LOG.md records each run. Journey falsifiers remove one check and show the reference-double test for that wrong behaviour fails; they prove the harness, not the Runtime.",
  "falsifiers": [
    {
      "id": "F-RI-a3-dwell",
      "title": "A3 skips the residency snapshot after the dwell",
      "command": "resident-instances",
      "expect": "caught",
      "edits": [
        {
          "file": "../../lab/resident-instances/src/journey.rs",
          "old": "        j.together(\n            &[&a, &b],\n            |state| *state == State::Running,\n            \"running\",\n            \"after start returned and the dwell passed\",\n        )?;\n",
          "new": ""
        }
      ],
      "tests": [
        "a3_refuses_instances_that_leave_after_start"
      ]
    },
    {
      "id": "F-RI-a3-processes",
