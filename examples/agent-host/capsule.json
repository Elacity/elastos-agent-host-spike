{
  "schema": "elastos.capsule/v1",
  "name": "agent-host",
  "version": "0.1.0",
  "description": "Agent Host journal and document plan guest. It asks for write and read on its own task journal, and write on the exact Runtime plan submit resource. The document plan waits for owner approval. No Home icon.",
  "author": "local-development",
  "role": "app",
  "type": "wasm",
  "runtime_abi": "elastos.component/v1",
  "bus_contract": "elastos:bus@v1",
  "wit_world_sha256": "7a026e0a641c8c04214576dc85a677e0b52c9f02866d231119f9a3ba609d49e2",
  "execution": "component",
  "projections": ["facts"],
  "entrypoint": "agent-host.component.wasm",
  "asks": [
    {
      "resource": "localhost://Users/self/.AppData/Agents/agent-host/*",
      "actions": ["write", "read"]
    },
    {
      "resource": "elastos://inspect/submit_agent_plan",
      "actions": ["write"]
    },
    {
      "resource": "localhost://UsersAI/self/Documents/*",
      "actions": ["write"]
    }
  ],
  "resources": {
    "memory_mb": 16,
    "cpu_shares": 10,
    "gpu": false
  }
}
