{
  "schema": "elastos.capsule/v1",
  "name": "docs-reader",
  "version": "0.1.0",
  "description": "Documents: show the docs-viewer pages bound to this launch. Render only; read-only; no authority of its own.",
  "author": "local-development",
  "role": "viewer",
  "type": "wasm",
  "runtime_abi": "elastos.runtime-projection/v1",
  "bus_contract": "elastos.runtime-projection/v1",
  "execution": "web-projection",
  "projections": ["web"],
  "entrypoint": "browser/index.html",
  "interfaces": [
    {
      "id": "elastos.docs.reader",
      "version": "0.1.0",
      "description": "Discoverability only; grants nothing.",
      "methods": [
        {
          "id": "pages.show",
          "description": "Show the pages bound to this launch",
          "risk": "read",
          "approval": "runtime_policy",
          "audit": "event",
          "resource": "localhost://Users/self/.AppData/App/docs-viewer/pages.json",
          "operation": "show"
        }
      ]
    }
  ],
  "resources": {
    "memory_mb": 16,
    "gpu": false
  }
}
