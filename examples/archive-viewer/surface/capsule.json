{
  "schema": "elastos.capsule/v1",
  "name": "archive-reader",
  "version": "0.1.0",
  "description": "Archive: show the archive-viewer view bound to this launch. Render only; read-only; no authority of its own.",
  "author": "local-development",
  "role": "viewer",
  "type": "wasm",
  "runtime_abi": "elastos.runtime-projection/v1",
  "bus_contract": "elastos.runtime-projection/v1",
  "execution": "web-projection",
  "projections": ["web"],
  "entrypoint": "browser/index.html",
  "interfaces": [
    {
      "id": "elastos.archive.reader",
      "version": "0.1.0",
      "description": "Discoverability only; grants nothing.",
      "methods": [
        {
          "id": "view.show",
          "description": "Show the view bound to this launch",
          "risk": "read",
          "approval": "runtime_policy",
          "audit": "event",
          "resource": "localhost://Users/self/.AppData/App/archive-viewer/view.json",
          "operation": "show"
        }
      ]
    }
  ],
  "resources": {
    "memory_mb": 16,
    "gpu": false
  }
}
