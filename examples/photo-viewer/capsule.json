{
  "schema": "elastos.capsule/v1",
  "name": "photo-viewer",
  "version": "0.1.0",
  "description": "Read an album of PNG, JPEG and WebP images by grant, check type, size and dimensions, and write a playlist. No display of its own.",
  "author": "local-development",
  "role": "app",
  "type": "wasm",
  "runtime_abi": "elastos.component/v1",
  "bus_contract": "elastos:bus@v1",
  "wit_world_sha256": "7a026e0a641c8c04214576dc85a677e0b52c9f02866d231119f9a3ba609d49e2",
  "execution": "component",
  "projections": ["facts"],
  "entrypoint": "photo-viewer.component.wasm",
  "permissions": {
    "storage": [
      "localhost://Users/self/Pictures/*",
      "localhost://Users/self/.AppData/App/photo-viewer/*"
    ]
  },
  "resources": {
    "memory_mb": 16,
    "cpu_shares": 10,
    "gpu": false
  }
}
